# Brand extraction + content generation (Steps 2 and 3)
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults: extraction claude-opus-5 (vision + design
# judgement, the wedge), strategy and generation claude-sonnet-5.
# Allowed: claude-opus-5 ($5/$25) | claude-sonnet-5 ($2/$10) | claude-haiku-4-5 ($1/$5)
# EXTRACT_MODEL=claude-sonnet-5
# STRATEGY_MODEL=claude-haiku-4-5
# GENERATE_MODEL=claude-haiku-4-5

# Written automatically by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=

# Step 7, optional. An app password from bsky.app settings, not your real one.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
